# Text files are stored and checked out with LF line endings on every platform, whatever git's own settings are;
# Windows batch files need CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
# Other authors' libraries are kept exactly as fetched, so their checksums hold (decision 0135).
clank/components/agents/artifact_lib/** -text
